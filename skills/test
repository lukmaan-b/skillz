import {
  forwardRef,
  useCallback,
  useEffect,
  useImperativeHandle,
  useLayoutEffect,
  useMemo,
  useReducer,
  useRef,
  useState,
} from "react";

/* =====================================================================
   price.js — pure. No DOM, no React. This is the file you unit-test.
   ===================================================================== */

// Japanese/Chinese IMEs in full-width mode emit ０-９ and ．/。 for the period
// key. Fold to ASCII rather than rejecting, or a Tokyo desk can't type at all.
const toAscii = (s) =>
  s
    .replace(/[０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0))
    .replace(/[．。｡，､]/g, ".");

export function sanitize(raw, maxDecimals) {
  let s = toAscii(raw).replace(/[^\d.]/g, "");
  const dot = s.indexOf(".");
  if (dot !== -1) {
    const int = s.slice(0, dot);
    const dec = s.slice(dot + 1).replace(/\./g, "").slice(0, maxDecimals);
    s = int + "." + dec;
  }
  return s.slice(0, 24);
}

/** Total split — defined for "", "1", "1." and every other intermediate. */
export function segment(value, pipDecimal) {
  const dot = value.indexOf(".");
  const int = dot === -1 ? value : value.slice(0, dot);
  const dec = dot === -1 ? "" : value.slice(dot + 1);
  return {
    big: int + (dot === -1 ? "" : ".") + dec.slice(0, pipDecimal - 2),
    pips: dec.slice(pipDecimal - 2, pipDecimal),
    frac: dec.slice(pipDecimal),
  };
}

// Integer pipettes: 1.0945 + 0.0001 is not 1.0946 in float.
export const toPipettes = (v, d) => Math.round((Number(v) || 0) * 10 ** d);
export const fromPipettes = (n, d) => (Math.max(0, n) / 10 ** d).toFixed(d);
export const stepBy = (value, decimals, delta) =>
  fromPipettes(toPipettes(value, decimals) + delta, decimals);

/**
 * Splice `insert` over [start, end) and return the sanitized result plus the
 * caret position. Pure — this is the entire editing model.
 */
export function spliceValue(value, { start, end }, insert, maxDecimals) {
  const next = sanitize(value.slice(0, start) + insert + value.slice(end), maxDecimals);
  const caret = Math.min(
    sanitize(value.slice(0, start) + insert, maxDecimals).length,
    next.length
  );
  return { value: next, caret };
}

/** Map a native `beforeinput` event to the next value. null = reject. */
export function reduceInput(inputType, data, value, sel, maxDecimals) {
  const { start, end } = sel;
  const collapsed = start === end;

  switch (inputType) {
    case "insertText":
    case "insertReplacementText":
    case "insertFromDrop":
      return spliceValue(value, sel, data || "", maxDecimals);

    case "deleteContentBackward":
    case "deleteWordBackward":
    case "deleteSoftLineBackward":
      if (!collapsed) return spliceValue(value, sel, "", maxDecimals);
      if (start === 0) return null;
      return spliceValue(value, { start: start - 1, end }, "", maxDecimals);

    case "deleteContentForward":
    case "deleteWordForward":
      if (!collapsed) return spliceValue(value, sel, "", maxDecimals);
      if (start >= value.length) return null;
      return spliceValue(value, { start, end: end + 1 }, "", maxDecimals);

    case "deleteByCut":
    case "deleteContent":
      return spliceValue(value, sel, "", maxDecimals);

    // Everything else — formatting, paragraphs, history — is rejected.
    default:
      return null;
  }
}

/* =====================================================================
   selection.js — pure DOM helpers. Logical offsets into textContent.
   ===================================================================== */

export function readSelection(el) {
  const sel = document.getSelection();
  if (!sel || sel.rangeCount === 0) return null;
  const range = sel.getRangeAt(0);
  if (!el.contains(range.startContainer) || !el.contains(range.endContainer)) return null;
  const probe = range.cloneRange();
  probe.selectNodeContents(el);
  probe.setEnd(range.startContainer, range.startOffset);
  const start = probe.toString().length;
  return { start, end: start + range.toString().length };
}

export function writeCaret(el, offset) {
  const sel = document.getSelection();
  if (!sel) return;
  const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
  const range = document.createRange();
  let left = offset;
  let node;
  let last = null;
  while ((node = walker.nextNode())) {
    if (left <= node.nodeValue.length) {
      range.setStart(node, left);
      break;
    }
    left -= node.nodeValue.length;
    last = node;
  }
  if (!node) {
    if (last) range.setStart(last, last.nodeValue.length);
    else range.setStart(el, 0);
  }
  range.collapse(true);
  sel.removeAllRanges();
  sel.addRange(range);
}

/* =====================================================================
   hooks
   ===================================================================== */

/** Standard controlled/uncontrolled contract, like any other input. */
function useControllableState({ value, defaultValue, onChange }) {
  const [inner, setInner] = useState(defaultValue ?? "");
  const controlled = value !== undefined;
  const onChangeRef = useRef(onChange);
  useLayoutEffect(() => {
    onChangeRef.current = onChange;
  });

  const set = useCallback(
    (next) => {
      if (!controlled) setInner(next);
      onChangeRef.current?.(next);
    },
    [controlled]
  );

  return [controlled ? value : inner, set];
}

/**
 * The one escape hatch. React's `onBeforeInput` is a legacy `textInput` shim
 * and doesn't expose `inputType`, which is the entire point of the event.
 */
function useBeforeInput(ref, handler) {
  const cb = useRef(handler);
  useLayoutEffect(() => {
    cb.current = handler;
  });
  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const fn = (e) => cb.current(e);
    el.addEventListener("beforeinput", fn);
    return () => el.removeEventListener("beforeinput", fn);
  }, [ref]);
}

/* =====================================================================
   PipPriceInput.jsx
   ===================================================================== */

export const PipPriceInput = forwardRef(function PipPriceInput(
  {
    value: valueProp,
    defaultValue,
    onChange,
    onCommit,
    pipDecimal = 4, // 4 for EUR/USD, 2 for USD/JPY — from instrument metadata
    pipetteDigits = 1,
    disabled = false,
    "aria-label": ariaLabel = "Limit price",
  },
  forwardedRef
) {
  const elRef = useRef(null);
  const caretRef = useRef(null);
  const composingRef = useRef(false);
  const frameRef = useRef(0);

  // Composition is the only time the browser writes to this subtree, so it is
  // the only time React's tree goes stale. Bumping this remounts the spans.
  const [revision, resync] = useReducer((n) => n + 1, 0);

  const decimals = pipDecimal + pipetteDigits;
  const [value, setValue] = useControllableState({
    value: valueProp,
    defaultValue,
    onChange,
  });
  const parts = useMemo(() => segment(value, pipDecimal), [value, pipDecimal]);

  const apply = useCallback(
    (result) => {
      if (!result) return;
      caretRef.current = result.caret;
      setValue(result.value);
    },
    [setValue]
  );

  /* --- editing: React is the only writer, except during composition ----- */

  useBeforeInput(elRef, (e) => {
    // insertCompositionText is not cancelable; let the IME own the DOM.
    if (composingRef.current || e.inputType === "insertCompositionText") return;

    e.preventDefault();
    const sel = readSelection(elRef.current);
    if (!sel) return;
    apply(reduceInput(e.inputType, e.data, value, sel, decimals));
  });

  const handleCompositionStart = () => {
    composingRef.current = true;
  };

  const handleCompositionEnd = () => {
    composingRef.current = false;
    // Browsers disagree on whether `input` fires before or after
    // `compositionend`. Deferring a frame makes this run exactly once, after
    // the browser has torn down its composition node.
    cancelAnimationFrame(frameRef.current);
    frameRef.current = requestAnimationFrame(() => {
      const el = elRef.current;
      if (!el || composingRef.current) return;
      const sel = readSelection(el);
      const raw = el.textContent;
      const next = sanitize(raw, decimals);
      caretRef.current = sel
        ? Math.min(sanitize(raw.slice(0, sel.start), decimals).length, next.length)
        : next.length;
      resync(); // React's tree is stale — force it to re-own the spans
      setValue(next);
    });
  };

  const handlePaste = (e) => {
    e.preventDefault();
    const sel = readSelection(elRef.current);
    if (!sel) return;
    apply(spliceValue(value, sel, e.clipboardData.getData("text/plain"), decimals));
  };

  const handleKeyDown = (e) => {
    // Enter confirms an IME candidate. Reading it as "submit" here would
    // confirm the candidate and fire the order in one keystroke. keyCode 229
    // is the pre-`isComposing` signal from older Safari and Android WebViews.
    if (e.nativeEvent.isComposing || e.keyCode === 229) return;

    if (e.key === "Enter") {
      e.preventDefault();
      onCommit?.(value);
      return;
    }
    if (e.key === "ArrowUp" || e.key === "ArrowDown") {
      e.preventDefault();
      const size = e.shiftKey ? 1 : 10 ** pipetteDigits; // shift = pipette
      const next = stepBy(value, decimals, e.key === "ArrowUp" ? size : -size);
      caretRef.current = next.length;
      setValue(next);
    }
  };

  const handleBlur = () => {
    if (value === "") return;
    const normalized = fromPipettes(toPipettes(value, decimals), decimals);
    if (normalized !== value) setValue(normalized);
    onCommit?.(normalized);
  };

  /* --- caret restoration: the only DOM write React doesn't do ----------- */

  useLayoutEffect(() => {
    const el = elRef.current;
    if (caretRef.current == null || !el) return;
    if (document.activeElement === el) writeCaret(el, caretRef.current);
    caretRef.current = null;
  });

  useEffect(() => () => cancelAnimationFrame(frameRef.current), []);

  useImperativeHandle(
    forwardedRef,
    () => ({
      focus: () => elRef.current?.focus(),
      blur: () => elRef.current?.blur(),
      get value() {
        return value;
      },
    }),
    [value]
  );

  return (
    <div
      ref={elRef}
      className="pip-input"
      contentEditable={!disabled}
      suppressContentEditableWarning
      role="textbox"
      aria-label={ariaLabel}
      aria-disabled={disabled || undefined}
      tabIndex={disabled ? -1 : 0}
      inputMode="decimal"
      enterKeyHint="done"
      spellCheck={false}
      autoCorrect="off"
      autoCapitalize="off"
      data-empty={value === "" || undefined}
      onCompositionStart={handleCompositionStart}
      onCompositionEnd={handleCompositionEnd}
      onKeyDown={handleKeyDown}
      onPaste={handlePaste}
      onBlur={handleBlur}
    >
      <span key={`big-${revision}`} className="pip-big">
        {parts.big}
      </span>
      <span key={`pips-${revision}`} className="pip-pips">
        {parts.pips}
      </span>
      <span key={`frac-${revision}`} className="pip-frac">
        {parts.frac}
      </span>
    </div>
  );
});

/* =====================================================================
   demo
   ===================================================================== */

const INSTRUMENTS = {
  "EUR/USD": { pipDecimal: 4, mid: "1.09453" },
  "USD/JPY": { pipDecimal: 2, mid: "156.784" },
  "GBP/USD": { pipDecimal: 4, mid: "1.27219" },
};

export default function Demo() {
  const [symbol, setSymbol] = useState("EUR/USD");
  const cfg = INSTRUMENTS[symbol];
  const [price, setPrice] = useState(cfg.mid);
  const [log, setLog] = useState("—");

  return (
    <div className="stage">
      <style>{css}</style>
      <div className="ticket">
        <div className="ticket-head">
          <span className="tag">LIMIT</span>
          <div className="symbols">
            {Object.keys(INSTRUMENTS).map((s) => (
              <button
                key={s}
                className={s === symbol ? "sym on" : "sym"}
                onClick={() => {
                  setSymbol(s);
                  setPrice(INSTRUMENTS[s].mid);
                }}
              >
                {s}
              </button>
            ))}
          </div>
        </div>

        <span className="field-label">Limit price</span>
        <PipPriceInput
          key={symbol}
          value={price}
          pipDecimal={cfg.pipDecimal}
          onChange={setPrice}
          onCommit={(v) => setLog(`Committed ${symbol} @ ${v}`)}
        />

        <div className="meta">
          <span>Mid {cfg.mid}</span>
          <span>↑↓ 1 pip · ⇧↑↓ 0.1 pip</span>
        </div>
        <div className="log">{log}</div>
      </div>
    </div>
  );
}
